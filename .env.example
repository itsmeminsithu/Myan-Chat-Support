# Copy to .env only when configuring manually. Never commit real values.
MCS_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
MCS_DB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
MCS_SETUP_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
MCS_PORT=8088

# For HTTPS-terminating reverse proxies; set 1 on your production deployment.
MCS_FORCE_HTTPS=0
# Exact trusted proxy IPs (comma separated). Edge MUST overwrite X-Forwarded-For.
MCS_TRUSTED_PROXIES=

# Automatic cleanup retention (30..3650 days), running daily in Compose.
MCS_RETENTION_DAYS=90
